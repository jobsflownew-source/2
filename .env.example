# ============================================
# Horror Shorts Automation - Configuracion MVP
# Modo: Generacion 100% IA (sin Reddit)
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=horror
POSTGRES_PASSWORD=changeme_strong_pass
POSTGRES_DB=horror_shorts
POSTGRES_PORT=5432

# --- n8n ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n
GENERIC_TIMEZONE=Europe/Madrid
N8N_ENCRYPTION_KEY=generate_a_random_32_char_string_here

# --- Render service ---
RENDER_PORT=8000
RENDER_API_KEY=changeme_internal_api_key

# --- MinIO (storage local S3-compatible) ---
MINIO_ROOT_USER=horror
MINIO_ROOT_PASSWORD=changeme_minio_pass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=horror-assets

# --- OpenAI (REQUERIDO - para generacion de historias y guion) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o

# --- TTS ---
# Opcion A: Edge-TTS (gratis, sin clave) - usado por defecto
# Opcion B: Azure (recomendado para garantia, free tier 500k chars/mes)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_DEFAULT_VOICE=es-ES-AlvaroNeural
TTS_LANGUAGE=es-ES

# --- Imagenes (todas FREE TIER) ---
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- YouTube Data API v3 ---
# Setup: ver docs/SETUP.md seccion 12
# 1. Crea proyecto en Google Cloud Console
# 2. Habilita YouTube Data API v3
# 3. Crea OAuth 2.0 Client ID tipo "Desktop app"
# 4. Ejecuta: python3 scripts/youtube_oauth.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# public | unlisted | private
YOUTUBE_DEFAULT_PRIVACY=public
# 24=Entertainment, 22=People&Blogs, 27=Education, 1=Film&Animation
YOUTUBE_DEFAULT_CATEGORY_ID=24

# --- TikTok Content Posting API ---
# Setup:
# 1. Crea cuenta en https://developers.tiktok.com
# 2. Crea una app, activa "Login Kit" + "Content Posting API"
# 3. Scopes minimos: video.upload (Direct Inbox, sin audit)
#    Para publicacion directa: anade tambien video.publish (requiere audit)
# 4. Registra Redirect URI: http://localhost:8094/callback
# 5. Anade tu cuenta TikTok como tester en Sandbox
# 6. Ejecuta: python3 scripts/tiktok_oauth.py
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
# 'inbox' (Direct Inbox, llega al inbox del creador, sin audit) |
# 'direct' (Direct Post, publica directamente, requiere audit)
TIKTOK_PUBLISH_MODE=inbox
# Para Direct Post: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS |
# FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Discord (notificaciones) ---
DISCORD_WEBHOOK_URL=

# --- General ---
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=es
MAX_SHORTS_PER_DAY=5

# ============================================
# Horror Shorts Automation - Configuracion MVP
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=horror
POSTGRES_PASSWORD=changeme_strong_pass
POSTGRES_DB=horror_shorts
POSTGRES_PORT=5432

# --- n8n ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n
GENERIC_TIMEZONE=Europe/Madrid
N8N_ENCRYPTION_KEY=generate_a_random_32_char_string_here

# --- Render service ---
RENDER_PORT=8000
RENDER_API_KEY=changeme_internal_api_key

# --- MinIO (storage local S3-compatible) ---
MINIO_ROOT_USER=horror
MINIO_ROOT_PASSWORD=changeme_minio_pass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=horror-assets

# --- Reddit API ---
# Crear app en https://www.reddit.com/prefs/apps (tipo "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=horror-shorts-bot/1.0

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o

# --- TTS ---
# Opcion A: Azure (recomendado, free tier 500k chars/mes)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Opcion B: Edge-TTS (gratis, sin clave) - se usa como fallback
TTS_DEFAULT_VOICE=es-ES-AlvaroNeural
TTS_LANGUAGE=es-ES

# --- Imagenes ---
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- YouTube Data API v3 ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- General ---
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=es
MAX_SHORTS_PER_DAY=5

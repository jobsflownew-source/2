{
  "name": "WF3_Production",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron 4h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH today_count AS (\n  SELECT COUNT(*) AS n\n  FROM app.shorts\n  WHERE status IN ('rendered','uploading','published')\n    AND created_at >= DATE_TRUNC('day', now() AT TIME ZONE 'UTC')\n),\nmax_day AS (\n  SELECT (value::text)::int AS m FROM app.policy_params WHERE key='max_shorts_per_day'\n)\nSELECT\n  c.id AS candidate_id,\n  c.title,\n  c.score,\n  c.author,\n  (SELECT n FROM today_count) AS produced_today,\n  COALESCE((SELECT m FROM max_day), 5) AS max_per_day,\n  GREATEST(COALESCE((SELECT m FROM max_day), 5) - (SELECT n FROM today_count), 0) AS remaining\nFROM app.reddit_candidates c\nWHERE c.status = 'queued'\nORDER BY c.quality_score DESC NULLS LAST, c.score DESC\nLIMIT 1;"
      },
      "id": "pick-candidate",
      "name": "Pick next queued",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-app",
          "name": "Postgres app"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-candidate",
              "leftValue": "={{ $json.candidate_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "remaining",
              "leftValue": "={{ $json.remaining }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-can-produce",
      "name": "Can produce?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "http://render-service:8000/produce",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-API-Key", "value": "={{ $env.RENDER_API_KEY }}"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"candidate_id\": {{ $json.candidate_id }},\n  \"language\": \"{{ $env.DEFAULT_LANGUAGE || 'es' }}\",\n  \"burn_subtitles\": true\n}",
        "options": {
          "timeout": 600000,
          "retry": {
            "enabled": true,
            "maxRetries": 1,
            "waitBetweenTries": 30000
          }
        }
      },
      "id": "call-produce",
      "name": "Produce short",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"content\": null,\n  \"embeds\": [{\n    \"title\": \"WF3 Short renderizado\",\n    \"description\": \"**{{ $json.title }}**\\n{{ $json.description }}\",\n    \"fields\": [\n      {\"name\": \"Short ID\", \"value\": \"{{ $json.short_id }}\", \"inline\": true},\n      {\"name\": \"Idioma\", \"value\": \"{{ $json.language }}\", \"inline\": true},\n      {\"name\": \"Duracion\", \"value\": \"{{ $json.duration_sec }}s\", \"inline\": true},\n      {\"name\": \"Segmentos\", \"value\": \"{{ $json.segments_count }}\", \"inline\": true},\n      {\"name\": \"Voz\", \"value\": \"{{ $json.voice }}\", \"inline\": true},\n      {\"name\": \"Tamano\", \"value\": \"{{ Math.round($json.file_size_bytes / 1024 / 1024) }} MB\", \"inline\": true},\n      {\"name\": \"Video\", \"value\": \"{{ $json.video_url }}\"}\n    ],\n    \"color\": 3066993\n  }]\n}",
        "options": {}
      },
      "id": "discord-success",
      "name": "Discord OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"content\": null,\n  \"embeds\": [{\n    \"title\": \"WF3 sin trabajo o limite alcanzado\",\n    \"description\": \"Producidos hoy: **{{ $json.produced_today || 0 }}/{{ $json.max_per_day || 5 }}**\\nProximo intento: en 4h\",\n    \"color\": 16776960\n  }]\n}",
        "options": {}
      },
      "id": "discord-skip",
      "name": "Discord skip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Cron 4h": {"main": [[{"node": "Pick next queued", "type": "main", "index": 0}]]},
    "Pick next queued": {"main": [[{"node": "Can produce?", "type": "main", "index": 0}]]},
    "Can produce?": {
      "main": [
        [{"node": "Produce short", "type": "main", "index": 0}],
        [{"node": "Discord skip", "type": "main", "index": 0}]
      ]
    },
    "Produce short": {"main": [[{"node": "Discord OK", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "tags": [{"name": "horror-shorts"}, {"name": "production"}]
}

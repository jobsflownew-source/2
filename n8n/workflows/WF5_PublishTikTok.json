{
  "name": "WF5_PublishTikTok",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron 2h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH today_uploads AS (\n  SELECT COUNT(*) AS n\n  FROM app.shorts\n  WHERE tiktok_status = 'published'\n    AND tiktok_published_at >= DATE_TRUNC('day', now() AT TIME ZONE 'UTC')\n),\nmax_uploads AS (\n  SELECT COALESCE((value::text)::int, 10) AS m\n  FROM app.policy_params WHERE key='max_tiktok_uploads_per_day'\n),\ntoggle AS (\n  SELECT (value::text)::boolean AS enabled\n  FROM app.policy_params WHERE key='tiktok_enabled'\n)\nSELECT\n  s.id AS short_id,\n  s.title,\n  s.language,\n  s.duration_sec,\n  s.file_size_bytes,\n  (SELECT n FROM today_uploads) AS uploaded_today,\n  COALESCE((SELECT m FROM max_uploads), 10) AS max_per_day,\n  COALESCE((SELECT enabled FROM toggle), true) AS tiktok_enabled,\n  GREATEST(\n    COALESCE((SELECT m FROM max_uploads), 10) - (SELECT n FROM today_uploads),\n    0\n  ) AS remaining\nFROM app.shorts s\nWHERE s.status IN ('rendered','uploading','published')\n  AND (s.tiktok_status IS NULL OR s.tiktok_status IN ('pending','failed'))\nORDER BY s.created_at ASC\nLIMIT 1;"
      },
      "id": "pick-rendered",
      "name": "Pick next for TikTok",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-app",
          "name": "Postgres app"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-short",
              "leftValue": "={{ $json.short_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "remaining",
              "leftValue": "={{ $json.remaining }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "enabled",
              "leftValue": "={{ $json.tiktok_enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-can-publish",
      "name": "Can publish?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://render-service:8000/publish-tiktok",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-API-Key", "value": "={{ $env.RENDER_API_KEY }}"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"short_id\": {{ $json.short_id }},\n  \"poll\": true\n}",
        "options": {
          "timeout": 600000,
          "retry": {
            "enabled": true,
            "maxRetries": 1,
            "waitBetweenTries": 30000
          }
        }
      },
      "id": "call-publish-tiktok",
      "name": "Upload to TikTok",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": null,\n  \"embeds\": [{\n    \"title\": \"WF5 Short publicado en TikTok\",\n    \"description\": \"**{{ $json.title }}**\",\n    \"fields\": [\n      {\"name\": \"Short ID\", \"value\": \"{{ $json.short_id }}\", \"inline\": true},\n      {\"name\": \"Modo\", \"value\": \"{{ $json.mode }}\", \"inline\": true},\n      {\"name\": \"Status\", \"value\": \"{{ $json.tiktok_status }}\", \"inline\": true},\n      {\"name\": \"TikTok ID\", \"value\": \"{{ $json.tiktok_publish_id }}\", \"inline\": false}\n    ],\n    \"color\": 39423\n  }]\n}",
        "options": {}
      },
      "id": "discord-success",
      "name": "Discord OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": null,\n  \"embeds\": [{\n    \"title\": \"WF5 sin trabajo, limite alcanzado o deshabilitado\",\n    \"description\": \"Subidos hoy: **{{ $json.uploaded_today || 0 }}/{{ $json.max_per_day || 10 }}**\\nTikTok enabled: {{ $json.tiktok_enabled }}\\nProximo intento: en 2h\",\n    \"color\": 16776960\n  }]\n}",
        "options": {}
      },
      "id": "discord-skip",
      "name": "Discord skip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    }
  ],
  "connections": {
    "Cron 2h": {"main": [[{"node": "Pick next for TikTok", "type": "main", "index": 0}]]},
    "Pick next for TikTok": {"main": [[{"node": "Can publish?", "type": "main", "index": 0}]]},
    "Can publish?": {
      "main": [
        [{"node": "Upload to TikTok", "type": "main", "index": 0}],
        [{"node": "Discord skip", "type": "main", "index": 0}]
      ]
    },
    "Upload to TikTok": {"main": [[{"node": "Discord OK", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "tags": [{"name": "horror-shorts"}, {"name": "publish"}, {"name": "tiktok"}]
}
